FROM node:22-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY internal/i18n/messages/ /src/internal/i18n/messages/
RUN npm run build

FROM golang:1.27-bookworm AS iorun-deps
ARG TARGETARCH=amd64
ARG SPIDERMONKEY=v158.0.1-aistudio2api.1
ARG LIBWEBP=v1.6.0-aistudio2api.1
RUN mkdir /opt/spidermonkey-gnu /opt/libwebp-gnu \
    && curl -fsSL https://github.com/Mag1cFall/firefox/releases/download/$SPIDERMONKEY/spidermonkey-$SPIDERMONKEY-linux-$TARGETARCH-gnu.tar.gz | tar --no-same-owner -xz -C /opt/spidermonkey-gnu \
    && curl -fsSL https://github.com/Mag1cFall/libwebp/releases/download/$LIBWEBP/libwebp-$LIBWEBP-linux-$TARGETARCH-gnu.tar.gz | tar --no-same-owner -xz -C /opt/libwebp-gnu
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

FROM iorun-deps AS build
ENV GOMAXPROCS=2 GOMEMLIMIT=768MiB GOFLAGS=-p=1
COPY . .
COPY --from=web /src/internal/webui/dist internal/webui/dist
RUN sh deploy/iorun/build.sh

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata libstdc++6 \
    libgtk-3-0 libasound2 libnss3 libdbus-glib-1-2 libxtst6 libxrandr2 libgbm1 libxkbcommon0 \
    libpango-1.0-0 libcairo2 libxcomposite1 libxdamage1 libxfixes3 libx11-xcb1 \
    xvfb \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /data
ENV LISTEN_ADDR=0.0.0.0:2048
ENV PREVIEW_LISTEN_ADDR=0.0.0.0:2050
EXPOSE 2048 2050
CMD ["aistudio2api", "-open-ui=false"]

FROM runtime
COPY --from=build /out/aistudio2api /usr/local/bin/aistudio2api
COPY LICENSE /usr/share/doc/aistudio2api/LICENSE
